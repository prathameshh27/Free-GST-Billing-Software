# /etc/caddy/Caddyfile - HTTPS in front of the GST Portal.
# Caddy gets and renews a free Let's Encrypt certificate for the name below
# by itself (ports 80 and 443 must be open). To use your own domain later,
# point its DNS at the server and change the name here.
130-210-127-108.sslip.io {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
	header {
		-Server
	}
	log {
		output file /var/log/caddy/gst-portal.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
