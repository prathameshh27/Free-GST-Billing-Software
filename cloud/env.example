# Settings for the GST Portal cloud server.
# Local development: copy to cloud/.env.local (git-ignored).
# Server: /etc/gst-portal/env (owner root, mode 600).

GSP_PORT=3000
GSP_HOST=127.0.0.1
# The address people open. Writes from any other origin are refused.
GSP_PUBLIC_ORIGIN=http://localhost:5173
# 1 on the server (HTTPS); 0 for http://localhost development.
GSP_COOKIE_SECURE=0
GSP_SESSION_DAYS=7

GSP_DB_HOST=130.210.127.108
GSP_DB_PORT=3306
GSP_DB_USER=gst_app
GSP_DB_PASSWORD=
# gst_portal on the server; gst_portal_dev for development and tests.
GSP_DB_NAME=gst_portal_dev
GSP_DB_SSL=1

# Recurring invoices auto-fire hourly (off in development if you prefer).
GSP_RUN_RECURRING=0
TZ=Asia/Kolkata
